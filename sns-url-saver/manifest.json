{
  "manifest_version": 3,
  "name": "SNS URL Saver",
  "version": "1.0",
  "description": "Save SNS URLs and metadata to Google Sheets via GAS",
  "permissions": [
    "contextMenus",
    "activeTab",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "*://script.google.com/*",
    "*://script.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "commands": {
    "save-url": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Save current tab URL to Google Sheets"
    }
  }
}
